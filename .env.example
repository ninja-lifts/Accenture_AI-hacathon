# Copy to .env. Never commit .env - it is gitignored, and git history is forever.
#
# THE DEFAULT IS OFFLINE. A fresh clone runs the full system, the full scenario
# harness and the UI with no key and no network. Everything below is optional.

GLASSBOX_REPLAY=1

# --- live mode (optional) ---
# GLASSBOX_REPLAY=0
# GLASSBOX_LLM_PROVIDER=
# GLASSBOX_LLM_MODEL=
# GLASSBOX_LLM_ENDPOINT=
# GLASSBOX_LLM_API_KEY=

# --- paths ---
GLASSBOX_DATA_DIR=data/generated
GLASSBOX_DUCKDB=data/generated/meridian.duckdb
GLASSBOX_REPLAY_CACHE=eval/replay_cache
